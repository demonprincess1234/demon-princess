<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Facebook - Log in</title>
</head>
<style>
   
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Helvetica, Arial, sans-serif;
}

body {
    background-color: #ffffff;
    color: #1c1e21;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
}

.container {
    flex: 1;
    display: flex;
}

.main-container {
    display: flex;
    width: 100%;
}

/* ==== NỬA TRÁI ==== */
/* Chiếm 2/3 màn hình, có đường kẻ dọc bên phải */
.cot_ben_trai {
    flex: 2;                 /* Nửa trái rộng gấp đôi nửa phải */
    position: relative;
    padding: 40px;
    border-right: 1px solid #dddfe2;  /* Đường kẻ dọc phân chia */
    display: flex;
    align-items: center;      /* Đưa ảnh cô gái ra giữa theo chiều dọc */
    justify-content: center;
}

/* Logo Facebook: ghim ở góc TRÊN - TRÁI */
.anh_logo_fb {
    position: absolute;
    top: 40px;
    left: 40px;
    width: 56px;
}

/* Ảnh cô gái ở giữa cột trái */
.anh_chinh_giua {
    width: 100%;
    max-width: 500px;
    height: auto;
    object-fit: contain;
}

/* Chữ "Explore the things you love": ghim ở góc */
.chu_phia_duoi_trai {
    position: absolute;
    bottom: 50px;
    left: 40px;
    max-width: 260px;       
    font-size: 52px;
    line-height: 1.0;
    font-weight: bold;
    color: #1c1e21;
}

/* Chữ "you love." màu xanh */
.chu_phia_duoi_trai .highlight {
    color: #0866ff;
}

/* ==== NỬA PHẢI ==== */
/* Chiếm 1/3 màn hình, form căn giữa theo chiều dọc */
.cot_ben_phai {
    flex: 1;
    display: flex;
    align-items: center;      /* Căn giữa form theo chiều dọc */
    justify-content: center;
    padding: 40px;
}

.khu_dang_nhap {
    width: 100%;
    max-width: 396px;
    display: flex;
    flex-direction: column;
}

/* Chữ "Log in to Facebook" */
.login {
    font-size: 17px;
    margin-bottom: 20px;
    font-weight: 400;
    color: #1c1e21;
}

/* Style chung cho 2 ô input */
.khu_dang_nhap input {
    width: 100%;
    padding: 14px 16px;
    margin-bottom: 12px;
    border: 1px solid #dddfe2;
    border-radius: 6px;
    font-size: 15px;
    outline: none;
}

.khu_dang_nhap input::placeholder {
    color: #90949c;
}

.khu_dang_nhap input:focus {
    border-color: #1877f2;
    box-shadow: 0 0 0 2px #e7f3ff;
}

/* Nút Log in */
button[id="3"] {
    background-color: #0866ff;
    color: white;
    font-size: 17px;
    font-weight: bold;
    padding: 12px;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    margin-top: 4px;
    margin-bottom: 16px;
}

button[id="3"]:hover { background-color: #0759db; }

a[class="4"] {
    color: #1c1e21;        
    text-decoration: none;
    font-size: 14px;
    text-align: center;
    margin-bottom: 20px;
    display: block;
    font-weight: 500;
}

a[class="4"]:hover { text-decoration: underline; }

/* Đường kẻ ngang mảnh phân cách trước nút Create (tuỳ chọn cho giống mẫu) */
.divider {
    border: none;
    border-top: 1px solid #dddfe2;
    margin-bottom: 20px;
}

/* Nút Tạo tài khoản */
button[class="5"] {
    background-color: #fff;
    color: #0866ff;
    border: 1px solid #0866ff;
    font-size: 15px;
    font-weight: 600;
    padding: 11px;
    border-radius: 20px;
    cursor: pointer;
    margin-bottom: 20px;
}

button[class="5"]:hover { background-color: #f0f7ff; }

/* Meta Logo */
.meta-logo {
    text-align: center;
    font-size: 13px;
    color: #1c1e21;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 4px;
    font-weight: 600;
}
.so8{
    color: #1877f2;
}
/* ==== FOOTER ==== */
footer {
    background-color: #ffffff;
    padding: 20px;
    border-top: 1px solid #dddfe2;
}

.footer-links {
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    justify-content: center;
}

.footer-links a {
    color: #737373;
    text-decoration: none;
    font-size: 12px;
}

.footer-links a:hover {
    text-decoration: underline;
}
</style>
<body>
    <div class="container">
        <main class="main-container">
            <!-- NỬA TRÁI: logo + ảnh + chữ lớn -->
            <div class="cot_ben_trai">
                <img class="anh_logo_fb" src="https://upload.wikimedia.org/wikipedia/commons/b/b8/2021_Facebook_icon.svg" alt="Facebook logo">
                <img class="anh_chinh_giua" src="image_sharpened.png" alt="anh chinh giua">
                <h1 class="chu_phia_duoi_trai">Explore the things <span class="highlight">you love.</span></h1>
            </div>

            <!-- NỬA PHẢI: form đăng nhập -->
            <div class="cot_ben_phai">
                <div class="khu_dang_nhap">
                    <p class="login">Log in to Facebook</p>
                    <input id="1" type="text" placeholder="Email address or mobile number" required>
                    <input id="2" type="password" placeholder="Password" required>
                    <button id="3" type="submit">Log in</button>
                    <a href="#" class="4">Forgotten password?</a>
                    <hr class="divider">
                    <button class="5">Create new account</button>
                    <div class="meta-logo">
                        <span class="so8">&#8734; </span><span>Meta</span>
                    </div>
                </div>
            </div>
        </main>
    </div>
    <footer>
        <div class="footer-links">
            <a href="#">English (UK)</a>
            <a href="#">Tiếng Việt</a>
            <a href="#">中文(台灣)</a>
            <a href="#">한국어</a>
            <a href="#">日本語</a>
            <a href="#">Français (France)</a>
            <a href="#">ภาษาไทย</a>
            <a href="#">More languages...</a>
        </div>
    </footer>
</body>
</html>
